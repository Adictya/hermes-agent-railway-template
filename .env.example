# Internal dashboard server
PORT=8081

# Public reverse proxy
PROXY_PORT=8080
API_SERVER_PORT=8642
WEBHOOK_PORT=8644

# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional Linear webhook verification for routes like /webhooks/linear-*
LINEAR_WEBHOOK_SECRET=
LINEAR_WEBHOOK_MAX_AGE_SECONDS=60

# All other Hermes configuration (LLM providers, messaging channels, tool API keys)
# is managed through the web UI at /configure
