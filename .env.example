# Public reverse proxy. On Railway, PORT is provided automatically.
PORT=8080
PROXY_PORT=8080

# Internal services
DASHBOARD_PORT=8081
API_SERVER_PORT=8642
WEBHOOK_PORT=8644

# ZenNotes notes server (served at /notes; uses its own auth token)
ZENNOTES_PORT=7878
ZENNOTES_VAULT_PATH=/data/Documents/Obsidian Vault
# Optional: set a fixed token. If unset, one is generated and persisted at
# /data/.zennotes/auth-token and printed to the deploy logs on first boot.
ZENNOTES_AUTH_TOKEN=

# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Core model/provider config
LLM_MODEL=openrouter/openai/gpt-4.1-mini
OPENROUTER_API_KEY=

# Example messaging config
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Optional: make cron and notification delivery target a specific chat/channel
TELEGRAM_HOME_CHANNEL=

# Optional Linear webhook verification for routes like /webhooks/linear-*
LINEAR_WEBHOOK_SECRET=
LINEAR_WEBHOOK_MAX_AGE_SECONDS=60
